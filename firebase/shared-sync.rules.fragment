// V215: FRAGMENT, keine vollständige Regeldatei.
// Innerhalb von match /databases/{database}/documents einfügen.
// Die Guards müssen mit UND in JEDE bestehende Schreibfreigabe für clubs
// integriert werden. Eine überlappende pauschale allow-write-Regel umgeht sie!
// Bestehende Lese- und Anmelde-/Rollenbedingungen unverändert beibehalten.

function kcRoot(clubId) {
  return /databases/$(database)/documents/clubs/$(clubId)/state/current;
}
function kcNextRevision(clubId) {
  let root = kcRoot(clubId);
  return exists(root) && get(root).data.keys().hasAll(['syncRevision'])
    ? get(root).data.syncRevision + 1 : 1;
}
function kcSharedCommand(clubId) {
  let root = getAfter(kcRoot(clubId)).data;
  let operation = root.syncOperation;
  let proof = /databases/$(database)/documents/clubs/$(clubId)/syncCommands/$(operation);
  return root.syncProtocol == 1
    && root.syncRevision == kcNextRevision(clubId)
    && root.updatedAt == request.time
    && operation is string
    && operation.matches('^sync_[a-zA-Z0-9_-]{1,120}$')
    && !exists(proof)
    && existsAfter(proof)
    && getAfter(proof).data.commandId == operation
    && getAfter(proof).data.createdAt == request.time;
}
function kcSharedRow(clubId) {
  let root = getAfter(kcRoot(clubId)).data;
  return kcSharedCommand(clubId)
    && request.resource.data.syncProtocol == 1
    && request.resource.data.syncRevision == root.syncRevision
    && request.resource.data.syncOperation == root.syncOperation
    && request.resource.data.updatedAt == request.time;
}
function kcSharedReceipt(clubId, commandId) {
  return kcSharedCommand(clubId)
    && commandId == getAfter(kcRoot(clubId)).data.syncOperation
    && request.resource.data.commandId == commandId;
}

// Integration in bestehende Matches (AUTH steht hier für die bereits
// vorhandene Zugriffsbedingung und ist KEIN ausführbarer Funktionsname):
//
// clubs/{clubId}:                       create/update: AUTH && kcSharedRow(clubId)
// clubs/{clubId}/state/current:         create/update: AUTH && kcSharedRow(clubId)
// clubs/{clubId}/livePersons/{id}:      create/update: AUTH && kcSharedRow(clubId)
//                                      delete: AUTH && kcSharedCommand(clubId)
// clubs/{clubId}/liveGames/{id}:        create/update: AUTH && kcSharedRow(clubId)
//                                      delete: AUTH && kcSharedCommand(clubId)
// clubs/{clubId}/live/seating:          create/update: AUTH && kcSharedRow(clubId)
// clubs/{clubId}/archive/{id}:          create/update: AUTH && kcSharedRow(clubId)
//                                      delete: AUTH && kcSharedCommand(clubId)
// clubs/{clubId}/documents/{id}:          create/update: AUTH && kcSharedRow(clubId)
// clubs/{clubId}/syncCommands/{id}:     create: AUTH && kcSharedReceipt(clubId, id)
//                                      update/delete: NICHT freigeben
// Root/Club-Löschungen sind kein unterstützter App-Befehl.
// Weitere Schreibpfade aus der bestehenden Regeldatei ebenfalls prüfen.
